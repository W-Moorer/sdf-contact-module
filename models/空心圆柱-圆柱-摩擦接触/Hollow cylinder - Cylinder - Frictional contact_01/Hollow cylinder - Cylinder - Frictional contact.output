<?xml version="1.0" encoding="UTF-8"?>
<DOCUMENT>
	<OBJECT keyword="RIGID_BODY" name="Professional" type="Body">
		<ENTITIES>
			<ENTITY name="Body1" type="BOOL">TRUE</ENTITY>
			<ENTITY name="Body2" type="BOOL">TRUE</ENTITY>
		</ENTITIES>
		<ARRAYPROPERTY arraysize="4">
			<PROPERTY keyword="Position" type="BOOL">TRUE</PROPERTY>
			<PROPERTY keyword="Velocity" type="BOOL">TRUE</PROPERTY>
			<PROPERTY keyword="Acceleration" type="BOOL">TRUE</PROPERTY>
			<PROPERTY keyword="Energy" type="BOOL">TRUE</PROPERTY>
		</ARRAYPROPERTY>
	</OBJECT>
	<OBJECT keyword="TRANSLATIONAL_AXIAL_FORCE_GROUP" name="Professional" type="Force">
		<ENTITIES>
			<ENTITY name="Axial1" type="BOOL">TRUE</ENTITY>
		</ENTITIES>
		<ARRAYPROPERTY arraysize="1">
			<PROPERTY keyword="Applied Force" type="BOOL">TRUE</PROPERTY>
		</ARRAYPROPERTY>
	</OBJECT>
	<OBJECT keyword="GGEOM_CONTACT_GROUP" name="Professional" type="Contact">
		<ENTITIES>
			<ENTITY name="GeoSurContact1" type="BOOL">TRUE</ENTITY>
		</ENTITIES>
		<ARRAYPROPERTY arraysize="2">
			<PROPERTY keyword="Contact Force" type="BOOL">TRUE</PROPERTY>
			<PROPERTY keyword="Contact Point" type="BOOL">TRUE</PROPERTY>
		</ARRAYPROPERTY>
	</OBJECT>
	<OBJECT keyword="FIXED_JOINT" name="Professional" type="Joint">
		<ENTITIES>
			<ENTITY name="Fixed1" type="BOOL">TRUE</ENTITY>
		</ENTITIES>
		<ARRAYPROPERTY arraysize="1">
			<PROPERTY keyword="Reaction Force" type="BOOL">TRUE</PROPERTY>
		</ARRAYPROPERTY>
	</OBJECT>
	<OBJECT keyword="CYLINDRICAL_JOINT" name="Professional" type="Joint">
		<ENTITIES>
			<ENTITY name="Cylindrical1" type="BOOL">TRUE</ENTITY>
		</ENTITIES>
		<ARRAYPROPERTY arraysize="6">
			<PROPERTY keyword="Relative Position" type="BOOL">TRUE</PROPERTY>
			<PROPERTY keyword="Relative Velocity" type="BOOL">TRUE</PROPERTY>
			<PROPERTY keyword="Relative Acceleration" type="BOOL">TRUE</PROPERTY>
			<PROPERTY keyword="Reaction Force" type="BOOL">TRUE</PROPERTY>
			<PROPERTY keyword="Driving Force" type="BOOL">TRUE</PROPERTY>
			<PROPERTY keyword="Friction Force" type="BOOL">TRUE</PROPERTY>
		</ARRAYPROPERTY>
	</OBJECT>
	<OBJECT keyword="EXPRESSION_NAME" name="Professional" type="Expression">
		<ENTITIES>
			<ENTITY name="Ex1" type="BOOL">TRUE</ENTITY>
			<ENTITY name="Ex2" type="BOOL">TRUE</ENTITY>
		</ENTITIES>
		<ARRAYPROPERTY arraysize="1">
			<PROPERTY keyword="Value" type="BOOL">TRUE</PROPERTY>
		</ARRAYPROPERTY>
	</OBJECT>
</DOCUMENT>
